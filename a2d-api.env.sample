# Sample environment file for the Amused to Death API systemd service.
#
# On the server, copy this to /etc/a2d-api.env, fill in real values, and lock it down:
#   sudo cp a2d-api.env.sample /etc/a2d-api.env
#   sudo chown root:root /etc/a2d-api.env
#   sudo chmod 600 /etc/a2d-api.env
#
# Format is KEY=value (systemd EnvironmentFile). ASP.NET maps the double
# underscore "__" to nested configuration keys, so App__Discord__ClientId
# binds to App:Discord:ClientId. Do NOT wrap values in quotes unless the value
# itself should contain them.

# Neon Postgres connection string.
ConnectionStrings__Neon=Host=ep-xxxx-pooler.REGION.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true

# Discord OAuth (identity provider).
App__Discord__ClientId=CHANGE_ME
App__Discord__ClientSecret=CHANGE_ME
App__Discord__RedirectUri=https://amusedtodeath.eu/api/auth/discord/callback

# Battle.net client credentials.
App__BattleNet__ClientId=CHANGE_ME
App__BattleNet__ClientSecret=CHANGE_ME
App__BattleNet__Region=eu

# Discord webhooks (raid announcements / recruitment).
App__Webhooks__Announcement=https://discord.com/api/webhooks/CHANGE_ME
App__Webhooks__Recruitment=https://discord.com/api/webhooks/CHANGE_ME

# Install as /etc/sites/amused-to-death/runtime.env with mode 0600.
# Fill every CHANGE_ME value on the server; never commit the populated file.
ConnectionStrings__Neon=CHANGE_ME
App__FrontendBaseUrl=https://amusedtodeath.eu
App__CorsOrigins__0=https://amusedtodeath.eu
App__BattleNet__ClientId=CHANGE_ME
App__BattleNet__ClientSecret=CHANGE_ME
App__BattleNet__Region=eu
App__BattleNet__RedirectUri=https://amusedtodeath.eu/api/auth/bnet/callback
App__BattleNet__GuildName=Amused to Death
App__BattleNet__GuildRealmSlug=stormscale
App__BattleNet__AdminMaxRank=3
# Optional Discord webhook destinations; omit or leave empty when unused.
App__Webhooks__Announcement=
App__Webhooks__Recruitment=